---
import { render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { getPosts, postSlug } from '../../../data/posts';

export async function getStaticPaths() {
  const [es, en] = await Promise.all([getPosts('es'), getPosts('en')]);
  return en.map((post) => {
    const twin = es.find((other) => postSlug(other) === postSlug(post));
    return {
      params: { slug: postSlug(post) },
      props: { post, altHref: twin ? `/blog/${postSlug(twin)}` : '/blog' },
    };
  });
}

const { post, altHref } = Astro.props;
const { Content } = await render(post);
---

<Post lang="en" post={post} altHref={altHref}>
  <Content />
</Post>
