---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, postSlug } from '../../data/posts';

export async function getStaticPaths() {
  const [es, en] = await Promise.all([getPosts('es'), getPosts('en')]);
  return es.map((post) => {
    const twin = en.find((other) => postSlug(other) === postSlug(post));
    return {
      params: { slug: postSlug(post) },
      props: { post, altHref: twin ? `/en/blog/${postSlug(twin)}` : '/en/blog' },
    };
  });
}

const { post, altHref } = Astro.props;
const { Content } = await render(post);
---

<Post lang="es" post={post} altHref={altHref}>
  <Content />
</Post>
