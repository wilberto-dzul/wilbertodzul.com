---
import Base from '../../layouts/Base.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { copy, site } from '../../data/content';
import { getPosts } from '../../data/posts';

const posts = await getPosts('es');
---

<Base
  lang="es"
  altHref="/en/blog"
  current="/blog"
  title={`Escribo — ${site.name}`}
  description={copy.es.escribo.intro}
>
  <BlogIndex lang="es" posts={posts} />
</Base>
