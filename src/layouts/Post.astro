---
import Base from './Base.astro';
import Greca from '../components/Greca.astro';
import { base, site, ui, type Lang } from '../data/content';
import { formatDate, readingTime, type Post } from '../data/posts';

interface Props {
  lang: Lang;
  post: Post;
  altHref: string;
}
const { lang, post, altHref } = Astro.props;
const t = ui[lang];
const b = base(lang);
const { title, description, date, updated, tags, draft } = post.data;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<Base
  lang={lang}
  title={`${title} — ${site.name}`}
  description={description}
  altHref={altHref}
  current="/blog"
  ogType="article"
  jsonld={articleLd}
>
  <article class="wrap">
    <header class="article-head">
      <p class="mono meta-line">
        <a href={`${b}/blog`} class="back">{t.backToBlog}</a>
        <span>{formatDate(date, lang)}</span>
        <span>{readingTime(post)} {t.minRead}</span>
      </p>
      {draft && <p><span class="draft-flag">{t.draft}</span></p>}
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="article-body prose">
      <slot />
      {updated && <p class="mono updated">{t.updated}: {formatDate(updated, lang)}</p>}
    </div>

    <div class="tail">
      <Greca height={12} />
      <p class="mono">
        <a href={`${b}/blog`}>{t.backToBlog}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
  }

  .meta-line a {
    text-decoration: none;
    color: var(--accent);
  }

  .updated {
    margin-top: 2.5rem;
  }

  .tail {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .tail p {
    margin-top: 1rem;
  }

  .tail a {
    text-decoration: none;
  }
</style>
